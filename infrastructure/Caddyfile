# Public TLS entry point for the production override (docker-compose.prod.yml).
# APISENTINEL_DOMAIN and ACME_EMAIL come from .env; nothing secret lives in this file.
{
	email {$ACME_EMAIL}
	admin off
}

{$APISENTINEL_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# nginx (frontend container) already sets CSP and the other security headers, limits upload
	# size and only forwards /api/* and /actuator/health(/...) to the backend.
	reverse_proxy frontend:8080
}
