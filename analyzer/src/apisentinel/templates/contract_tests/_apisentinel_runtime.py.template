def _serialize(value: Any, style: str, explode: bool) -> list[str] | str:
    """Return repeated values (form+explode arrays) or one joined string."""
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, list):
        items = ["true" if v is True else "false" if v is False else str(v) for v in value]
        if style == "form" and explode:
            return items
        separator = {"spaceDelimited": " ", "pipeDelimited": "|"}.get(style, ",")
        return separator.join(items)
    return str(value)


class ApiClient:
    def __init__(self, base_url: str, timeout: float) -> None:
        self.base_url = base_url
        self.timeout = timeout
        self.token = os.environ.get("APISENTINEL_AUTH_TOKEN")

    def _auth(self, operation: dict[str, Any], headers: dict[str, str], query: list[Any]) -> None:
        auth = operation.get("auth")
        if not auth:
            return
        if not self.token:
            pytest.skip(
                f"requires authentication (scheme '{auth['scheme']}'); "
                "set APISENTINEL_AUTH_TOKEN to run it"
            )
        kind = auth["kind"]
        if kind == "bearer":
            headers["Authorization"] = f"Bearer {self.token}"
        elif kind == "basic":
            encoded = base64.b64encode(self.token.encode("utf-8")).decode("ascii")
            headers["Authorization"] = f"Basic {encoded}"
        elif kind == "apiKey" and auth["in"] == "header":
            headers[auth["name"]] = self.token
        elif kind == "apiKey" and auth["in"] == "query":
            query.append((auth["name"], self.token))
        elif kind == "apiKey" and auth["in"] == "cookie":
            cookie = headers.get("Cookie")
            pair = f"{auth['name']}={self.token}"
            headers["Cookie"] = f"{cookie}; {pair}" if cookie else pair

    def send(self, operation: dict[str, Any]) -> Response:
        request = operation["request"]
        path = operation["path"]
