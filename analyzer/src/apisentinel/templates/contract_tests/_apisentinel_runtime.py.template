            value = _serialize(spec["value"], "simple", spec["explode"])
            path = path.replace("{" + name + "}", urllib.parse.quote(str(value), safe=""))
        query: list[Any] = []
        for name, spec in request["query"].items():
            value = _serialize(spec["value"], spec["style"], spec["explode"])
            if isinstance(value, list):
                query.extend((name, v) for v in value)
            else:
                query.append((name, value))
        headers = {"Accept": "application/json, */*;q=0.5"}
        for name, spec in request["header"].items():
            headers[name] = str(_serialize(spec["value"], "simple", spec["explode"]))
        cookies = [f"{n}={_serialize(s['value'], 'form', False)}" for n, s in request["cookie"].items()]
        if cookies:
            headers["Cookie"] = "; ".join(cookies)
