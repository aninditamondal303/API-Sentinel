# Copy to .env and fill in real values (scripts/demo-backend.ps1 generates one with random secrets).
# Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=apisentinel
POSTGRES_USER=apisentinel
# Random, 32+ characters.
POSTGRES_PASSWORD=replace-with-a-generated-password

# --- Backend (Spring Boot) ---
# Base64-encoded HS256 key, at least 32 bytes before encoding.
# Generate with a CSPRNG, e.g.:  python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(48)).decode())"
APISENTINEL_JWT_SECRET=replace-with-base64-of-48-random-bytes
APISENTINEL_BACKEND_PORT=8080

# --- Analyzer service (Python / FastAPI) ---
# Shared secret the backend sends in the X-Internal-Token header. Minimum 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
APISENTINEL_INTERNAL_TOKEN=replace-with-a-generated-secret-of-32-plus-chars
APISENTINEL_MAX_SPEC_MB=5
APISENTINEL_LOG_LEVEL=INFO
# Interactive /docs and /openapi.json; keep false outside local development.
APISENTINEL_ENABLE_DOCS=false

# --- Generated contract tests (read at test run time) ---
# APISENTINEL_BASE_URL=http://localhost:8080
# APISENTINEL_AUTH_TOKEN=
